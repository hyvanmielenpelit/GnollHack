<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="config.props" />
  <PropertyGroup Label="Globals">
    <ProjectGuid>{5C1ABED1-C0D2-445D-A6E1-576FEFF59C93}</ProjectGuid>
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <!-- Set before dirs.props, whose ObjDir and PDB names use it, so they never collide with recover.vcxproj's -->
    <TargetName>recoverwin</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="console.props" />
  <Import Project="common.props" />
  <Import Project="dirs.props" />
  <Import Project="files.props" />
  <PropertyGroup>
    <OutDir>$(BinDir)</OutDir>
  </PropertyGroup>
  <!-- recover.c for the GnollHackM Windows engine: GNH_MOBILE and GNH_WIN give the engine's save file layout
       (SAVESIZE 77, not the tty game's 104) and winconf.h's lock names -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(IncDir);$(SysWinntDir);$(LibWinDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32CON;DLB;MSWIN_GRAPHICS;GNH_MOBILE;GNH_WIN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(UtilDir)recover.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(IncDir)config.h" />
    <ClInclude Include="$(IncDir)config1.h" />
    <ClInclude Include="$(IncDir)coord.h" />
    <ClInclude Include="$(IncDir)global.h" />
    <ClInclude Include="$(IncDir)tradstdc.h" />
    <ClInclude Include="$(LibWinDir)winconf.h" />
    <ClInclude Include="$(SysWinntDir)win32api.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="AfterBuild">
    <Message Text="Copying recover.exe to $(MauiWindowsGnhDir)" Importance="High" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(MauiWindowsGnhDir)recover.exe" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="AfterClean">
    <Delete Files="$(MauiWindowsGnhDir)recover.exe" />
  </Target>
</Project>
