<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- The engine library built on a Mac over SSH for iOS (gnollhackios.vcxproj) and macOS (gnollhackmac.vcxproj).
       Import after dirs.props. The project sets GnhApplePlatform (ios or macos), GnhAppleMinOS and GnhAppleLibName,
       and may add ClCompile items of its own. GnhAppleExtraArgs is passed on to Build-AppleEngine.ps1, for example
       /p:GnhAppleExtraArgs="-SshHost my-mac". The ClInclude items are for Solution Explorer and IntelliSense. -->
  <ItemGroup>
    <ClCompile Include="$(SrcDir)allmain.c" />
    <ClCompile Include="$(SrcDir)alloc.c" />
    <ClCompile Include="$(SrcDir)animation.c" />
