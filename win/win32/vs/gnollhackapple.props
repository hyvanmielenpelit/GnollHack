    <ClCompile Include="$(SrcDir)zap.c" />
    <ClCompile Include="$(SysShareDir)ioctl.c" />
    <ClCompile Include="$(SysShareDir)posixregex.c" />
    <ClCompile Include="$(SysShareDir)unixtty.c" />
    <ClCompile Include="$(WinShareDir)safeproc.c" />
    <ClCompile Include="$(LibShareDir)gnhapi.c" />
    <ClCompile Include="$(LibShareDir)gnhmain.c" />
    <ClCompile Include="$(LibShareDir)gnhunix.c" />
    <ClCompile Include="$(LibShareDir)libproc.c" />
    <ClCompile Include="$(LibShareDir)callback.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="$(IncDir)*.h" />
    <ClInclude Include="$(LibShareDir)*.h" />
  </ItemGroup>
  <PropertyGroup>
    <GnhAppleScript>$(RootDir)win\win32\xpl\gnollhackapple\Build-AppleEngine.ps1</GnhAppleScript>
    <GnhAppleSourceList>$(IntDir)gnh-sources.txt</GnhAppleSourceList>
    <GnhAppleCommand>powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(GnhAppleScript)" -Platform $(GnhApplePlatform) -Configuration $(Configuration) -MinOS $(GnhAppleMinOS) -SourceList "$(GnhAppleSourceList)" -IntDir "$(IntDir.TrimEnd('\'))" -OutDir "$(OutDir.TrimEnd('\'))" $(GnhAppleExtraArgs)</GnhAppleCommand>
    <NMakeBuildCommandLine>$(GnhAppleCommand)</NMakeBuildCommandLine>
    <NMakeReBuildCommandLine>$(GnhAppleCommand) -Clean</NMakeReBuildCommandLine>
    <NMakeCleanCommandLine>$(GnhAppleCommand) -CleanOnly</NMakeCleanCommandLine>
    <NMakeOutput>$(OutDir)$(GnhAppleLibName)</NMakeOutput>
    <PreNMakeBuildTarget>GnhWriteAppleSourceList</PreNMakeBuildTarget>
  </PropertyGroup>
  <!-- The C sources the script packs and engine.mk compiles: this project's ClCompile items -->
  <Target Name="GnhWriteAppleSourceList">
    <MakeDir Directories="$(IntDir)" />
    <WriteLinesToFile File="$(GnhAppleSourceList)" Lines="@(ClCompile->'%(FullPath)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
