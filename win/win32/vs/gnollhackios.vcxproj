<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{f6e7efa6-0470-47c8-a6b0-5de72bac7291}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <RootNamespace>gnollhackios</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="dirs.props" />
  <!-- libgnollhackios.a for the iOS app: arm64, built on the Mac over SSH -->
  <PropertyGroup>
    <!-- Not lower than the ios SupportedOSPlatformVersion in GnollHackM.csproj -->
    <GHiOSDeploymentTarget>15.0</GHiOSDeploymentTarget>
    <GnhApplePlatform>ios</GnhApplePlatform>
    <GnhAppleMinOS>$(GHiOSDeploymentTarget)</GnhAppleMinOS>
    <GnhAppleLibName>libgnollhackios.a</GnhAppleLibName>
    <NMakePreprocessorDefinitions>GNH_MOBILE;GNH_IOS;USE_TILES;DLB;LIB_GRAPHICS;SAFEPROCS;NOTTYGRAPHICS;GNOLLHACK_MAIN_PROGRAM;EXIT_THREAD_ON_EXIT;DUMPLOG;DUMPHTML</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(LibiOSDir);$(IncDir);$(LibShareDir)</NMakeIncludeSearchPath>
  </PropertyGroup>
  <Import Project="gnollhackapple.props" />
  <ItemGroup>
    <ClCompile Include="$(LibiOSDir)gnollhackios.c" />
    <ClInclude Include="$(LibiOSDir)iosconf.h" />
    <ClInclude Include="$(LibiOSDir)gnollhackios.h" />
    <ClInclude Include="$(LibiOSDir)date_unix.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyToiOSNativeReferences" AfterTargets="Build;Rebuild" Condition="Exists('$(OutDir)libgnollhackios.a')">
    <Message Text="Start building aftergnollhackios.proj" Importance="High" />
    <MSBuild Projects="aftergnollhackios.proj" Targets="Build" Properties="Configuration=$(Configuration);GnhiOSLib=$(OutDir)libgnollhackios.a" />
  </Target>
  <Target Name="CleaniOSNativeReferences" AfterTargets="Clean">
    <Message Text="Start cleaning aftergnollhackios.proj" Importance="High" />
    <MSBuild Projects="aftergnollhackios.proj" Targets="Clean" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
