<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="dirs.props"/>
  <Import Project="files.props"/>
  <!-- TODO not copying record-->
  <!--
    Inputs="$(GnhiOSLib)"
    Outputs="$(iOSNativeReferencesDir)libgnollhackios.a"
  -->
  <!-- GnhiOSLib: the library gnollhackios.vcxproj copied back from the Mac -->
  <Target Name="Build">
    <Error Condition="'$(GnhiOSLib)' == '' Or !Exists('$(GnhiOSLib)')" Text="aftergnollhackios.proj: GnhiOSLib '$(GnhiOSLib)' does not exist." />
    <Copy SkipUnchangedFiles="False" SourceFiles="$(GnhiOSLib)" DestinationFolder="$(iOSNativeReferencesDir)"/>
  <Message Text="Copied libgnollhackios.a from $(GnhiOSLib) to $(iOSNativeReferencesDir)" Importance="High" />
    <Copy SkipUnchangedFiles="False" SourceFiles="$(GnhiOSLib)" DestinationFolder="$(MauiiOSNativeReferencesDir)"/>
  <Message Text="Copied libgnollhackios.a from $(GnhiOSLib) to $(MauiiOSNativeReferencesDir)" Importance="High" />
  </Target>
  <Target Name="Clean">
    <Delete Files="$(iOSNativeReferencesDir)libgnollhackios.a"/>
  <Message Text="Deleted libgnollhackios.a from $(iOSNativeReferencesDir)" Importance="High" />
    <Delete Files="$(MauiiOSNativeReferencesDir)libgnollhackios.a"/>
  <Message Text="Deleted libgnollhackios.a from $(MauiiOSNativeReferencesDir)" Importance="High" />
  </Target>
</Project>
