<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{e615db70-9fcf-4f41-b7f5-55688997553a}</ProjectGuid>
    <Keyword>MakeFileProj</Keyword>
    <RootNamespace>gnollhackmac</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Makefile</ConfigurationType>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'!='Debug'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="dirs.props" />
  <!-- libgnollhackmac.dylib for the Avalonia macOS build: arm64 and x86_64, built on the Mac over SSH.
       The deployment target is .NET 11's oldest supported macOS. -->
  <PropertyGroup>
    <GnhApplePlatform>macos</GnhApplePlatform>
    <GHMacDeploymentTarget>15.0</GHMacDeploymentTarget>
    <GnhAppleMinOS>$(GHMacDeploymentTarget)</GnhAppleMinOS>
    <GnhAppleLibName>libgnollhackmac.dylib</GnhAppleLibName>
    <NMakePreprocessorDefinitions>GNH_MOBILE;GNH_MAC;USE_TILES;DLB;LIB_GRAPHICS;SAFEPROCS;NOTTYGRAPHICS;GNOLLHACK_MAIN_PROGRAM;EXIT_THREAD_ON_EXIT;DUMPLOG;DUMPHTML</NMakePreprocessorDefinitions>
    <NMakeIncludeSearchPath>$(LibMacDir);$(IncDir);$(LibShareDir)</NMakeIncludeSearchPath>
  </PropertyGroup>
  <Import Project="gnollhackapple.props" />
  <ItemGroup>
    <ClInclude Include="$(LibMacDir)macosconf.h" />
    <ClInclude Include="$(LibMacDir)date_unix.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyToMauiMacLibs" AfterTargets="Build;Rebuild" Condition="Exists('$(OutDir)libgnollhackmac.dylib')">
    <Copy SourceFiles="$(OutDir)libgnollhackmac.dylib" DestinationFolder="$(MauiMacLibsDir)" SkipUnchangedFiles="false" />
    <Message Text="Copied libgnollhackmac.dylib to $(MauiMacLibsDir)" Importance="High" />
  </Target>
  <Target Name="CleanMauiMacLibs" AfterTargets="Clean">
    <Delete Files="$(MauiMacLibsDir)libgnollhackmac.dylib" />
    <Message Text="Deleted libgnollhackmac.dylib from $(MauiMacLibsDir)" Importance="High" />
  </Target>
</Project>
