      <DebugInformationFormat>FullDebug</DebugInformationFormat>
      <AdditionalOptions>--sysroot=$(GnhLinuxSysroot) -Wall -Wno-unused-parameter -Wno-stringop-truncation -Wno-stringop-overflow -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion %(AdditionalOptions)</AdditionalOptions>
      <CAdditionalWarning>switch;no-deprecated-declarations;empty-body;return-type;parentheses;no-pointer-sign;no-format;uninitialized;unreachable-code;unused-function;unused-value;unused-variable</CAdditionalWarning>
