    </Link>
    <RemotePreBuildEvent>
      <Command>test -f $(GnhLinuxSysroot)/gnollhack-sysroot.txt || { echo "error: the glibc 2.27 sysroot is missing from $(GnhLinuxSysroot); run Install-LinuxSysroot.ps1"; exit 1; }</Command>
