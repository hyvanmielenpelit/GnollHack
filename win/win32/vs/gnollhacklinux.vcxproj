  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(IncDir);$(LibShareDir);$(LibLinuxDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_DEBUG;DEBUG;GNH_MOBILE;GNH_LINUX;USE_TILES;DLB;LIB_GRAPHICS;SAFEPROCS;NOTTYGRAPHICS;GNOLLHACK_MAIN_PROGRAM;EXIT_THREAD_ON_EXIT;DUMPLOG;DUMPHTML;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <UndefinePreprocessorDefinitions>WIN32;SUSPEND</UndefinePreprocessorDefinitions>
      <PositionIndependentCode>true</PositionIndependentCode>
      <Optimization>Disabled</Optimization>
      <DebugInformationFormat>FullDebug</DebugInformationFormat>
      <AdditionalOptions>--sysroot=$(GnhLinuxSysroot) -Wall -Wno-unused-parameter -Wno-stringop-truncation -Wno-stringop-overflow -Wno-error=implicit-function-declaration -Wno-error=incompatible-pointer-types -Wno-error=int-conversion %(AdditionalOptions)</AdditionalOptions>
      <CAdditionalWarning>switch;no-deprecated-declarations;empty-body;return-type;parentheses;no-pointer-sign;no-format;uninitialized;unreachable-code;unused-function;unused-value;unused-variable</CAdditionalWarning>
    </ClCompile>
    <Link>
      <OutputFile>$(TargetPath)</OutputFile>
      <LibraryDependencies>m;pthread;%(LibraryDependencies)</LibraryDependencies>
      <!-- -L: the sysroot's libc.so and libm.so; -B: its start files; -z defs: no symbol glibc 2.27 lacks -->
      <AdditionalOptions>--sysroot=$(GnhLinuxSysroot) -B$(GnhLinuxSysroot)/usr/lib/x86_64-linux-gnu -L$(GnhLinuxSysroot)/usr/lib/x86_64-linux-gnu -L$(GnhLinuxSysroot)/lib/x86_64-linux-gnu -Wl,-z,defs %(AdditionalOptions)</AdditionalOptions>
    </Link>
    <RemotePreBuildEvent>
      <Command>test -f $(GnhLinuxSysroot)/gnollhack-sysroot.txt || { echo "error: the glibc 2.27 sysroot is missing from $(GnhLinuxSysroot); run Install-LinuxSysroot.ps1"; exit 1; }</Command>
    </RemotePreBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(IncDir);$(LibShareDir);$(LibLinuxDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
