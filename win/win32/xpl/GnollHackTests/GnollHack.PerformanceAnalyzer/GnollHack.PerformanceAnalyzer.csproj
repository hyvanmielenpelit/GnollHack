<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GnollHack.PerformanceAnalyzer</RootNamespace>
    <AssemblyName>GnollHack.PerformanceAnalyzer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The statistics and the smoothness analysis are the same files the app compiles, so device and desktop agree. -->
  <ItemGroup>
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPerformanceStatistics.cs" Link="Shared\GHPerformanceStatistics.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHFrameRecord.cs" Link="Shared\GHFrameRecord.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHFrameTimeline.cs" Link="Shared\GHFrameTimeline.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPresentFeedback.cs" Link="Shared\GHPresentFeedback.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHSmoothnessMetrics.cs" Link="Shared\GHSmoothnessMetrics.cs" />
  </ItemGroup>

</Project>
