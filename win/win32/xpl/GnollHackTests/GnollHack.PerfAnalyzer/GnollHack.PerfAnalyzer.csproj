<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>GnollHack.PerfAnalyzer</RootNamespace>
    <AssemblyName>GnollHack.PerfAnalyzer</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- The statistics are the same file the app compiles, so device and desktop agree. -->
  <ItemGroup>
    <Compile Include="..\..\GnollHackX\GnollHackX\Perf\GHPerfStats.cs" Link="Shared\GHPerfStats.cs" />
  </ItemGroup>

</Project>
