<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>GnollHackX.Benchmarks</RootNamespace>
    <AssemblyName>GnollHackX.Benchmarks</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The linked files take their MAUI branch, which is the one the shipping app compiles. -->
    <DefineConstants>$(DefineConstants);GNH_MAUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.2" />
  </ItemGroup>

  <!-- The subjects are the same files the app compiles, linked rather than copied. -->
  <ItemGroup>
    <Compile Include="..\..\GnollHackX\GnollHackX\Perf\GHPerfStats.cs" Link="Shared\GHPerfStats.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\GHRefList.cs" Link="Shared\GHRefList.cs" />
  </ItemGroup>

</Project>
