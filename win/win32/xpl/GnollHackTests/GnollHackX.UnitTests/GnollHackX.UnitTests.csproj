<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>GnollHackX.UnitTests</RootNamespace>
    <AssemblyName>GnollHackX.UnitTests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The linked files take their MAUI branch, which is the one the shipping app compiles. -->
    <DefineConstants>$(DefineConstants);GNH_MAUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The subjects are the same files the app compiles, linked rather than copied. -->
  <ItemGroup>
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPerformanceStatistics.cs" Link="Shared\GHPerformanceStatistics.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHFrameRecord.cs" Link="Shared\GHFrameRecord.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHFrameTimeline.cs" Link="Shared\GHFrameTimeline.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPresentFeedback.cs" Link="Shared\GHPresentFeedback.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHSmoothnessMetrics.cs" Link="Shared\GHSmoothnessMetrics.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPerformanceComparison.cs" Link="Shared\GHPerformanceComparison.cs" />
    <Compile Include="..\..\GnollHackX\GnollHackX\Performance\GHPerformanceTextReport.cs" Link="Shared\GHPerformanceTextReport.cs" />
  </ItemGroup>

</Project>
