<?xml version="1.0" encoding="utf-8" ?>
<gnh:CustomModalPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gnh="clr-namespace:GnollHackX" 
             xmlns:controls="clr-namespace:GnollHackX.Controls"
             BackgroundColor="Black"
             x:Class="GnollHackX.Pages.MainScreen.ReplayPage"
             Appearing="ContentPage_Appearing"
             Disappearing="ContentPage_Disappearing">
    <gnh:CustomModalPage.Content>
        <Grid x:Name="RootGrid">
            <gnh:BackgroundView x:Name="bkgView" BackgroundStyle="Automatic" BackgroundBitmap="AutoMenuBackground" BorderStyle="Simple" HorizontalOptions="Fill" VerticalOptions="Fill"/>
            <Grid x:Name="MainGrid" WidthRequest  ="900" RowSpacing="6" HorizontalOptions="Center" VerticalOptions="Fill" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <!--<RowDefinition Height="Auto" />-->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Row="0" x:Name="HeaderLabel" Text="Select Recorded Game" HorizontalOptions="Center" VerticalOptions="Start" HorizontalTextAlignment="Center" FontSize="22" TextColor="Black" FontFamily="Immortal"/>
                <Label Grid.Row="1" x:Name="RecordingsLabel" Text="0 replays available" HorizontalOptions="Center" VerticalOptions="Start" HorizontalTextAlignment="Center" FontSize="16" TextColor="Black" FontFamily="Immortal"/>
                <CollectionView Grid.Row="2" x:Name="ReplayCollectionView" ItemSizingStrategy="MeasureAllItems" HorizontalOptions="Fill" VerticalOptions="Start" SelectionMode="Single"  BackgroundColor="Transparent" SelectionChanged="MainListView_SelectionChanged" >
                    <CollectionView.Header>
                        <Grid x:Name="HeaderGrid" Padding="10,4" ColumnSpacing="4" HorizontalOptions="Fill">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="45" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="45" />
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="0" Text="#" FontFamily="Immortal" FontSize="13" TextColor="Black" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                            <StackLayout Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Date" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="DateSortArrow" Text="&#x25BC;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Date" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Character" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="CharacterSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Character" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Turn" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="TurnSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Turn" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="4" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Version" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="VersionSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Version" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="5" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Size" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="SizeSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Size" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="6" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Files" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="FilesSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Files" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                            <StackLayout Grid.Column="7" Orientation="Horizontal" Spacing="2" VerticalOptions="Center">
                                <Label Text="Fmt" FontFamily="Immortal" FontSize="13" TextColor="Black" VerticalTextAlignment="Center" />
                                <Label x:Name="FormatSortArrow" Text="&#x21D5;" FontFamily="DejaVuSansMono" FontSize="10" TextColor="Black" VerticalTextAlignment="Center">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="SortHeader_Tapped" CommandParameter="Format" /></Label.GestureRecognizers>
                                </Label>
                            </StackLayout>
                        </Grid>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="gnh:GHRecordedGameFile">
                            <Grid ColumnSpacing="4" HorizontalOptions="Fill" VerticalOptions="Fill" Padding="10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="45" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="45" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#88FF8800" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Label Grid.Column="0" Text="{Binding FormattedIndex}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="13" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                <Label Grid.Column="1" Text="{Binding FormattedDate}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                <Label Grid.Column="2" Text="{Binding CharacterName}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="13" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                <Label Grid.Column="3" Text="{Binding TurnString}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="13" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                <Label Grid.Column="4" Text="{Binding VersionString}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                                <Label Grid.Column="5" Text="{Binding FormattedSize}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="13" HorizontalOptions="End" VerticalOptions="Center" HorizontalTextAlignment="End" VerticalTextAlignment="Center" />
                                <Label Grid.Column="6" Text="{Binding FormattedFiles}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                <Label Grid.Column="7" Text="{Binding FormatString}" FontFamily="Underwood" TextColor="{Binding TextColor}" FontSize="12" HorizontalOptions="Start" VerticalOptions="Center" HorizontalTextAlignment="Start" VerticalTextAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Label Grid.Row="2" x:Name="EmptyLabel" IsVisible="False" Text="No replays found" HorizontalOptions="Center" VerticalOptions="Start" HorizontalTextAlignment="Center" FontSize="18" TextColor="Black" FontFamily="Immortal"/>
                <Grid x:Name="BottomLayout" Grid.Row="3" HorizontalOptions="Fill" VerticalOptions="End">
                    <StackLayout x:Name="OuterButtonMainStack" Spacing="6" Orientation="Vertical"  HorizontalOptions="Center">
                        <StackLayout x:Name="ServerStack" Grid.Row="3" Spacing="6" Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="Center">
                            <Picker x:Name="FolderPicker"
                                            Title="Select a folder"
                                            FontFamily="Diablo" 
                                            FontSize="16"
                                            TextColor="Black"
                                            TitleColor="Black"
                                            HorizontalTextAlignment="Center"
                                            BackgroundColor="{x:Static gnh:GHColors.PickerLightModeBkgColor}"
                                            WidthRequest="200"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            SelectedIndexChanged="FolderPicker_SelectedIndexChanged">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Local</x:String>
                                        <x:String>Cloud</x:String>
                                        <x:String>Downloaded</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <!--<Label x:Name="ServerLabel" Text="Cloud" HorizontalOptions="End" VerticalOptions="Center" HorizontalTextAlignment="End" TextColor="Black" FontFamily="Diablo" FontSize="16" />
                            <Switch x:Name="ServerSwitch" HorizontalOptions="Start" VerticalOptions="Center" IsToggled="False" Toggled="ServerSwitch_Toggled" />-->
                        </StackLayout>
                        <StackLayout x:Name="ButtonMainStack" Spacing="6" Orientation="Vertical" HorizontalOptions="Center">
                            <StackLayout Orientation="Horizontal" Spacing="6">
                                <controls:CustomImageButton Text="More" x:Name="MoreButton" Clicked="MoreButton_Clicked" FontFamily="Diablo" FontSize="15" TextColor="White" BackgroundColor="Transparent" WidthRequest="120" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                                <controls:CustomImageButton Text="Play" x:Name="SelectButton" Clicked="SelectButton_Clicked" FontFamily="Diablo" FontSize="15" TextColor="White" BackgroundColor="Transparent" WidthRequest="120" HeightRequest="50" HorizontalOptions="Start" VerticalOptions="Center" />
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="6">
                                <controls:CustomImageButton Text="Multiple" x:Name="MultiButton" Clicked="MultiButton_Clicked" FontFamily="Diablo" FontSize="14" TextColor="White" BackgroundColor="Transparent" WidthRequest="120" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                                <controls:CustomImageButton Text="Close" x:Name="CloseButton" Clicked="CloseButton_Clicked" FontFamily="Diablo" FontSize="15" TextColor="White" BackgroundColor="Transparent" WidthRequest="120" HeightRequest="50" HorizontalOptions="Start" VerticalOptions="Center" />
                            </StackLayout>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
            <Grid x:Name="PopupGrid" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{x:Static gnh:GHColors.GeneralPageOverlayColor}" IsVisible="False">
                <Grid WidthRequest  ="600" Margin="5" HorizontalOptions="Center" VerticalOptions="Center">
                    <Frame x:Name="PopupFrame" BackgroundColor="{x:Static gnh:GHColors.MsgBoxLightModeBkgColor}" BorderColor="Black" CornerRadius="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout Spacing="6">
                            <Label Text="Actions" x:Name="PopupTitleLabel" FontFamily="Immortal" FontSize="20" TextColor="White" VerticalTextAlignment="Center" HorizontalOptions="Center"  />
                            <controls:CustomImageButton Text="Upload" x:Name="UploadButton" Clicked="UploadButton_Clicked" FontFamily="Diablo" FontSize="16" TextColor="White" BackgroundColor="Transparent" WidthRequest="180" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                            <controls:CustomImageButton Text="Share" x:Name="ShareButton" Clicked="ShareButton_Clicked" FontFamily="Diablo" FontSize="16" TextColor="White" BackgroundColor="Transparent" WidthRequest="180" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                            <controls:CustomImageButton Text="Delete" x:Name="DeleteButton" Clicked="DeleteButton_Clicked" FontFamily="Diablo" FontSize="16" TextColor="Red" BackgroundColor="Transparent" WidthRequest="180" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                            <controls:CustomImageButton Text="Cancel" x:Name="PopupCancelButton" Clicked="PopupCancelButton_Clicked" Margin="0,10,0,0" FontFamily="Diablo" FontSize="16" TextColor="White" BackgroundColor="Transparent" WidthRequest="180" HeightRequest="50" HorizontalOptions="End" VerticalOptions="Center" />
                        </StackLayout>
                    </Frame>
                </Grid>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid x:Name="UploadDownloadGrid" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{x:Static gnh:GHColors.GeneralPageOverlayColor}" IsVisible="False">
                <Grid WidthRequest  ="600" Margin="5" HorizontalOptions="Center" VerticalOptions="Center">
                    <Frame x:Name="UploadDownloadFrame" BackgroundColor="{x:Static gnh:GHColors.MsgBoxLightModeBkgColor}" BorderColor="Black" CornerRadius="10" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout Spacing="6">
                            <Label Text="Uploading..." x:Name="UploadDownloadTitleLabel" FontFamily="Immortal" FontSize="20" TextColor="White" VerticalTextAlignment="Center" HorizontalOptions="Center"  />
                            <Label Text="replay.gnhrec.gz" x:Name="UploadDownloadFileLabel" FontFamily="LatoRegular" FontSize="16" TextColor="White" VerticalTextAlignment="Start" HorizontalOptions="Center"  />
                            <Label Text="Please wait..." x:Name="UploadDownloadStatusLabel" FontFamily="Underwood" FontSize="16" TextColor="White" VerticalTextAlignment="Start" HorizontalOptions="Center"  />
                            <controls:CustomImageButton Text="Cancel" x:Name="UploadDownloadCancelButton" Clicked="UploadDownloadCancelButton_Clicked" Margin="0,10,0,0" FontFamily="Diablo" FontSize="16" TextColor="White" BackgroundColor="Transparent" WidthRequest="180" HeightRequest="50" HorizontalOptions="Center" VerticalOptions="Center" />
                        </StackLayout>
                    </Frame>
                </Grid>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid x:Name="CloudLoadingGrid" HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{x:Static gnh:GHColors.GeneralPageOverlayColor}" IsVisible="False">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                    <ActivityIndicator IsRunning="True" Color="White" />
                    <Label x:Name="CloudLoadingLabel" Text="Loading..." FontFamily="Immortal" FontSize="18" TextColor="White" HorizontalTextAlignment="Center" />
                </StackLayout>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>
    </gnh:CustomModalPage.Content>
</gnh:CustomModalPage>
