<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GnollHack.app's Info.plist. package-mac.sh fills in the {PLACEHOLDERS}. -->
<plist version="1.0">
<dict>
